# Copy to .env and edit. Never commit .env.
# Required to use /admin. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# UPI ID that receives the platform fee (use your own VPA)
PLATFORM_UPI_ID=yourname@upi
PLATFORM_PAYEE_NAME=BikePool
PLATFORM_FEE_INR=199
# SQLite file location
BIKEPOOL_DB=data/bikepool.db
